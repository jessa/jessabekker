# Lives on the server as /opt/apps/jessabekker/auth.env (chmod 600, never in git).
# Google Cloud project for jessabekker.be → Clients → Web application.
OAUTH2_PROXY_CLIENT_ID=
OAUTH2_PROXY_CLIENT_SECRET=
# 32 random bytes; deploy.sh fills this in on the server the first time.
OAUTH2_PROXY_COOKIE_SECRET=
